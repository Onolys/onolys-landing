---
import TryItButton from './TryItButton.astro';
import HeroVisual from './HeroVisual.astro';
import Section from './Section.astro';
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<Section id="hero" tone="hero" cta={false}>
  <div class="hero">
    <div class="hero-content">
      <h1>{title}</h1>
      <p class="hero-description">{description}</p>
      <div class="hero-cta"><TryItButton trigger="hero" /></div>
    </div>
    <HeroVisual />
  </div>
</Section>

<style>
  :global(#hero) { padding-block: 5rem 3.5rem; }
  .hero { display: grid; grid-template-columns: 58fr 42fr; gap: var(--space-12); align-items: center; }
  .hero-content { min-width: 0; }
  h1 { margin: 0; max-width: 23ch; font-size: clamp(2rem, 5vw, var(--font-size-3xl)); line-height: var(--line-height-heading); letter-spacing: -0.025em; }
  .hero-description { max-width: 44rem; margin-block: var(--space-6) 0; color: var(--color-gray-600); font-size: var(--font-size-lg); }
  .hero-cta { margin-top: var(--space-8); }
  @media (max-width: 47.5rem) {
    :global(#hero) { padding-block: 3rem 2.5rem; }
    .hero { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; }
    .hero > :global(.hero-vis) { display: none; }
  }
</style>
