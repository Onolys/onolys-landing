---
import { Image } from 'astro:assets';
import { team } from '../data/team';
import Section from './Section.astro';
import TryItButton from './TryItButton.astro';
---
<Section id="team" tone="team" heading="Team" cta={false}>
  <div class="cq">
    <div class="cards">
      {team.map((member) => (
        <article>
          <Image src={member.photo} alt={`Photo of ${member.name}`} width={208} height={208} format="webp" fit="cover" loading="lazy" />
          <h3>{member.name}</h3>
          <p class="bio"><strong>{member.lead}</strong>{member.rest}</p>
          <a class="linkedin" href={member.linkedin} aria-label={`${member.name} on LinkedIn`} target="_blank" rel="noopener noreferrer">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.46 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.29 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.39-.74 1.36-1.52 2.8-1.52 2.99 0 3.57 1.97 3.57 4.53v5.24Z" />
            </svg>
          </a>
        </article>
      ))}
    </div>
  </div>
  <div class="cta-row"><TryItButton trigger="team" /></div>
</Section>

<style>
  .cq { container-type: inline-size; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  article { min-width: 0; background: #fff; border: 1px solid #eadfc8; border-radius: 14px; padding: 1.25rem 1.1rem; display: flex; flex-direction: column; gap: 0.75rem; }
  img { display: block; width: 104px; height: 104px; border-radius: 14px; object-fit: cover; }
  h3 { margin: 0; font-size: 1.1rem; line-height: 1.3; letter-spacing: -0.01em; min-height: 2.6em; }
  .bio { margin: 0; color: var(--color-gray-600); font-size: 0.84rem; line-height: 1.55; min-height: 4.65em; }
  .bio strong { color: var(--color-text); font-weight: 700; }
  .linkedin { margin-top: auto; width: 34px; height: 34px; border-radius: 8px; border: 1px solid #d5ebe8; background: var(--color-gray-50); display: flex; align-items: center; justify-content: center; color: var(--color-accent); }
  .linkedin:hover { background: #d5ebe8; }
  .linkedin svg { width: 18px; height: 18px; }
  .cta-row { display: flex; justify-content: center; margin-top: var(--space-8); }
  @container (max-width: 639px) {
    .cards { grid-template-columns: 1fr; gap: 0.75rem; }
    article { display: grid; grid-template-columns: 76px 1fr; column-gap: 0.9rem; row-gap: 0.35rem; padding: 0.9rem; align-items: start; }
    img { grid-row: 1 / span 3; width: 76px; height: 76px; border-radius: 12px; }
    h3 { min-height: 0; font-size: 1rem; }
    .bio { font-size: 0.85rem; min-height: 0; }
    .linkedin { margin-top: 0.25rem; }
  }
</style>
