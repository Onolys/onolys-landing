---
import type { Page } from '../lib/context';
interface Props {
  page: Page;
}
const { page } = Astro.props;
---
<footer>
  <div class="container">
    <ul data-inline-list>
      <li>Not official MITI coding</li>
      <li>Use it to practice and prepare</li>
      <li>Role-play or de-identified transcripts only</li>
    </ul>
    <p>
      <a href="https://app.onolys.com/privacy">Privacy</a> · <a href="https://app.onolys.com/terms">Terms</a> · <a href="mailto:tejitpabari99@gmail.com">Contact</a>{' · '}
      {page === 'enterprise'
        ? <a href="/" data-footer-switch>Individuals</a>
        : <a href="/enterprise" data-footer-switch>Enterprise</a>}{' · '}© 2026 Onolys
    </p>
  </div>
</footer>

<style>
  footer { background: var(--tone-footer); color: #dcebe9; padding-block: 0.75rem; font-size: 0.8rem; line-height: 1.5; overflow-wrap: anywhere; }
  a { color: #9fe3d8; text-decoration: none; }
  a:hover { text-decoration: underline; }
  ul { margin: 0; padding: 0; list-style: none; }
  li { display: inline; }
  li + li::before { content: ' · '; white-space: pre; color: #9fcfc8; }
  p { margin: 0; }
</style>
